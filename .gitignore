# Credentials - NEVER commit these.
# Files matching these patterns carry access tokens + refresh tokens, which grant
# full access to an account. If one lands in a public repo, the tokens are treated
# as leaked and the accounts get killed.

cline-export-*.json
handover*.json
kirim*.json
account*.json
*.env
auths/
*.sqlite
*.sqlite-journal
*.sqlite-wal

# Python junk
__pycache__/
*.py[cod]
.venv/
venv/
