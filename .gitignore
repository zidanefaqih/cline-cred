# Credentials - NEVER commit these.
# Files matching these patterns carry access tokens + refresh tokens, which grant
# full access to an account. If one lands in a public repo, the tokens are treated
# as leaked and the accounts get killed.

# Every JSON file in this folder is either an exported credential set or a
# credential file handed to you. None of it belongs in git, so block JSON
# wholesale. If you ever need to commit a JSON file, force it: git add -f <file>
*.json

*.env
auths/
*.sqlite
*.sqlite-journal
*.sqlite-wal

# Python junk
__pycache__/
*.py[cod]
.venv/
venv/
